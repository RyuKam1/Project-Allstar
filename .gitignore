# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing (local only — not shipped)
/tests/
/coverage
.nyc_output

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# env & secrets (never commit)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling caches
.turbo/
.cache/
.parcel-cache/
.eslintcache
.swc/

# supabase local CLI state
.supabase/
.branches/

# database schema & migrations (local only — apply via Supabase dashboard/CLI)
/supabase/migrations/

# IDE / editor (local only)
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# cursor / local AI workspace (rules, skills, agent scratch)
.cursor/
.cursorrules
.agent/
*.jsonl

# backup / scratch files
*.backup
*.bak
*~

# planning & internal docs (README.md is the only doc in repo)
/docs/

# CI / dev automation (not production runtime)
/.github/

# OS / local overrides
*.local
